# Gemfile for local Jekyll development
# Requires Ruby 3.0+ (macOS system Ruby is 2.6; use: brew install ruby OR rbenv install 3.2)
source "https://rubygems.org"
gem "base64"       # required by safe_yaml on Ruby 3.4+
gem "bigdecimal"  # required by liquid on Ruby 3.4+
gem "jekyll", "~> 3.9"
gem "jekyll-sitemap"
gem "jekyll-feed"
gem "kramdown-parser-gfm"  # for GFM in _config.yml kramdown
